<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/confirm_passwordpro_pop_up"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pop_up_rounded"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/pop_up_guideline_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.49"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/pop_up_guideline_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.51"/>

    <TextView
        android:id="@+id/confirm_pop_up_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/roboto"
        android:text="Do you want to set the Password Protection?"
        android:textColor="@color/white"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/pop_up_cancelInput"
        android:layout_width="0dp"
        android:layout_height="25dp"
        android:text="@string/pop_up_cancel"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pop_up_guideline_right"
        app:layout_constraintTop_toBottomOf="@+id/confirm_pop_up_text"
        android:gravity="center"
        android:background="@color/ElementColor"
        android:fontFamily="@font/roboto"/>
    <TextView
        android:id="@+id/pop_up_confirmInput"
        android:layout_width="0dp"
        android:layout_height="25dp"
        android:text="@string/pop_up_confirm"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@id/pop_up_guideline_left"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirm_pop_up_text"
        android:gravity="center"
        android:background="@color/ElementColor"
        android:fontFamily="@font/roboto"/>

</androidx.constraintlayout.widget.ConstraintLayout>
