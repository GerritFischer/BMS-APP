<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.fragment_overview">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:src="@drawable/test" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fontFamily="@font/roboto"
        android:gravity="center"
        android:text="Fail/Pass View"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/FailPassTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:fontFamily="@font/roboto"
        android:text="@string/FailPassViewText"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/ErrorLogTestxView"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:fontFamily="@font/roboto"
        android:gravity="center|start"
        android:text="Errorr Log:"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="251dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/textView22"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warning: Low Voltage in Segment 5/ 16:33"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView21"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Error: Heat Sensor Malfunction/ 14:22"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto"
                android:text="Error: Receiving Out of bounce Values/ 12:49"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView19"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Error: Data received was too long/ 25:13"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView18"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Error: Cell Balancing failed/ 22:59"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warning: Rapid Voltage rise in Segment 1/ 20:40"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView15"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Error: No Connection to Server/ 18:38"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Error: Received out of bounce Voltage/ 16:05"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Error: Heat Sensor Malfunction/ 15:55"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warning: Rapid Voltage loss in segemt 1/ 20:44"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warning: High Temperature in Segment 1/ 15:49"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Error: Too may Errors/ 15:35"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Error: Negative time/ -8:62"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warning: Upcomming error Message/ 8:58"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Error: No connection to Server/ 6:00"
                android:textColor="@color/design_default_color_error" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warning: High Temperature in Segment 2"
                android:textColor="@color/design_default_color_error" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>