<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/pop_up_window"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pop_up_rounded"
        tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/pop_up_guideline_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.49"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/pop_up_guideline_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.51"/>



        <TextView
            android:id="@+id/pop_up_passwordEnterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editUser_enterpassword"
            android:textColor="@color/white"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/pop_up_passwordInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="12"
            android:inputType="textPassword"
            android:hint="@string/pop_up_password"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pop_up_passwordEnterText"
            android:layout_margin="10dp"
            />

        <TextView
            android:id="@+id/pop_up_cancelInput"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:text="@string/pop_up_cancel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/pop_up_guideline_right"
            app:layout_constraintTop_toBottomOf="@+id/pop_up_passwordInput"
            android:gravity="center"
            android:background="@color/ElementColor"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/pop_up_confirmInput"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:text="@string/pop_up_confirm"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="@id/pop_up_guideline_left"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pop_up_passwordInput"
            android:gravity="center"
            android:background="@color/ElementColor" />
    </androidx.constraintlayout.widget.ConstraintLayout>
