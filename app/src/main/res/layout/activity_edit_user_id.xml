<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EditUserID">
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/editUser_finBtn"
        android:layout_margin="30sp"
        android:onClick="finishBtn"/>
    <TextView
        android:id="@+id/editUser_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="50sp"
        android:layout_below="@+id/editUser_finBtn"
        android:text="@string/editUser_login"
        android:textColor="@color/black"
        android:textSize="35sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editUser_enterEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="@string/editUser_enter_EMail"
        android:ems="10"
        android:inputType="textEmailAddress"
        android:layout_below="@+id/editUser_login"
        android:layout_centerHorizontal="true"
        android:padding="15sp"/>

    <EditText
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/editUser_telefon"
        android:id="@+id/editUser_telefonnumber"
        android:layout_below="@+id/editUser_enterEmail"
        android:inputType="numberDecimal"
        android:layout_centerHorizontal="true"
        android:padding="15sp"/>

    <EditText
        android:id="@+id/editUser_enterPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/editUser_enterpassword"
        android:layout_below="@id/editUser_telefonnumber"
        android:layout_centerHorizontal="true"
        android:inputType="textPassword"
        android:padding="15sp"/>
    <EditText
        android:id="@+id/editUser_enterPassAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="@string/editUser_enterpassagain"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/editUser_enterPassword"
        android:ems="10"
        android:inputType="textPassword"
        android:padding="15sp"/>

    <Button
        android:id="@+id/editUser_btnsubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/editUser_enterPassAgain"
        android:layout_centerHorizontal="true"
        android:layout_margin="30sp"
        android:onClick="submitbtn"
        android:text="@string/editUser_submit" />


</RelativeLayout>