<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/BackgroundColor"
    android:orientation="vertical"
    tools:context=".fragments.fragment_overview">

    <ImageView
        android:id="@+id/iv_rubmo_logo"
        android:layout_width="327dp"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/rubmo_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.482"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:background="@color/BackgroundColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_rubmo_logo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/BackgroundColor"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_failpass"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/ElementColor"
                app:cardCornerRadius="5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:fontFamily="@font/roboto"
                        android:gravity="center"
                        android:text="Fail/Pass View"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/VoltageChart"
                        android:layout_width="120dp"
                        android:layout_height="450dp"
                        android:layout_marginStart="16dp"
                        android:background="@color/ElementColor"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/VoltageText" />

                    <TextView
                        android:id="@+id/VoltageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/roboto"
                        android:text="Voltage:"
                        android:textAlignment="center"
                        android:textSize="30sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView" />

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/TempChart"
                        android:layout_width="125dp"
                        android:layout_height="450dp"
                        android:layout_marginStart="64dp"
                        android:background="@color/ElementColor"
                        app:layout_constraintStart_toEndOf="@+id/VoltageChart"
                        app:layout_constraintTop_toBottomOf="@+id/TemperatureText" />

                    <TextView
                        android:id="@+id/TemperatureText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto"
                        android:gravity="center"
                        android:text="Teperature:"
                        android:textSize="30sp"
                        app:layout_constraintStart_toEndOf="@+id/VoltageText"
                        app:layout_constraintTop_toBottomOf="@+id/textView" />

                    <TextView
                        android:id="@+id/StatusText"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="50dp"
                        android:layout_marginStart="90dp"
                        android:fontFamily="@font/roboto"
                        android:text="Status:"
                        android:textSize="30sp"
                        app:layout_constraintStart_toEndOf="@+id/TempChart"
                        app:layout_constraintTop_toBottomOf="@+id/textView" />

                    <TextView
                        android:id="@+id/StatusMessage"
                        android:layout_width="125dp"
                        android:layout_height="125dp"
                        android:layout_marginStart="90dp"
                        android:background="@drawable/tv_segment_status_drawable"
                        android:fontFamily="@font/roboto"
                        android:gravity="center"
                        android:text="OK"
                        android:textColor="@color/white"
                        android:textSize="48sp"
                        app:layout_constraintStart_toEndOf="@+id/TempChart"
                        app:layout_constraintTop_toBottomOf="@+id/StatusText" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/ErrorlogviewTablet"
                        android:layout_width="500dp"
                        android:layout_height="500dp"
                        android:layout_marginEnd="44dp"
                        app:cardBackgroundColor="@color/slightybrighterelement"
                        app:cardCornerRadius="5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView">>

                        <ScrollView
                            android:id="@+id/innerscrollcard"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="0dp">

                            <LinearLayout
                                android:id="@+id/InnerScrollviewLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/textView2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Errors:"
                                    android:textAlignment="center"
                                    android:textColor="@color/white"
                                    android:textSize="30sp" />

                                <TextView
                                    android:id="@+id/Error1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Error1"
                                    android:textAlignment="center"
                                    android:textColor="@color/AlertColor"
                                    android:textSize="20dp"
                                    android:visibility="invisible" />

                                <TextView
                                    android:id="@+id/Error2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Error1"
                                    android:textAlignment="center"
                                    android:textColor="@color/AlertColor"
                                    android:textSize="20dp"
                                    android:visibility="invisible" />

                                <TextView
                                    android:id="@+id/Error3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Error1"
                                    android:textAlignment="center"
                                    android:textColor="@color/AlertColor"
                                    android:textSize="20dp"
                                    android:visibility="invisible" />

                                <TextView
                                    android:id="@+id/Error4"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Error1"
                                    android:textAlignment="center"
                                    android:textColor="@color/AlertColor"
                                    android:textSize="20dp"
                                    android:visibility="invisible" />

                                <TextView
                                    android:id="@+id/Error5"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Error1"
                                    android:textAlignment="center"
                                    android:textColor="@color/AlertColor"
                                    android:textSize="20dp"
                                    android:visibility="invisible" />

                                <TextView
                                    android:id="@+id/Error6"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Error1"
                                    android:textAlignment="center"
                                    android:textColor="@color/AlertColor"
                                    android:textSize="20dp"
                                    android:visibility="invisible" />

                                <TextView
                                    android:id="@+id/Error7"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Error1"
                                    android:textAlignment="center"
                                    android:textColor="@color/AlertColor"
                                    android:textSize="20dp"
                                    android:visibility="invisible" />

                                <TextView
                                    android:id="@+id/Error8"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Error1"
                                    android:textAlignment="center"
                                    android:textColor="@color/AlertColor"
                                    android:textSize="20dp"
                                    android:visibility="invisible" />

                                <TextView
                                    android:id="@+id/Error9"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Error1"
                                    android:textAlignment="center"
                                    android:textColor="@color/AlertColor"
                                    android:textSize="20dp"
                                    android:visibility="invisible" />

                                <TextView
                                    android:id="@+id/Error10"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Error1"
                                    android:textAlignment="center"
                                    android:textColor="@color/AlertColor"
                                    android:textSize="20dp"
                                    android:visibility="invisible" />

                                <TextView
                                    android:id="@+id/Error11"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Error1"
                                    android:textAlignment="center"
                                    android:textColor="@color/AlertColor"
                                    android:textSize="20dp"
                                    android:visibility="invisible" />

                                <TextView
                                    android:id="@+id/Error12"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Error1"
                                    android:textAlignment="center"
                                    android:textColor="@color/AlertColor"
                                    android:textSize="20dp"
                                    android:visibility="invisible" />
                            </LinearLayout>
                        </ScrollView>
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_error_message"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/ElementColor"
                app:cardCornerRadius="5dp">

                <TextView
                    android:id="@+id/tv_error_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:text="TextView"
                    android:textSize="16sp" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>